DJANGO_SETTINGS_MODULE=config.settings.local
CELERY_BROKER_URL=amqp://broker:5672//
REDIS_URL=redis://result:6379

# This project uses PostgreSQL. For Docker, uncomment the line below as-is.
DATABASE_URL=postgres://config:password@db:5432/config
# DATABASE_URL=sqlite:///db.sqlite3

# Shared secret used by mock_processor to sign webhooks (X-Processor-Signature)
# and by the payments app to verify them. MUST be set to a strong random value
# in any real environment. Example placeholder below — do NOT use in production.
PROCESSOR_WEBHOOK_SECRET=replace-with-a-long-random-secret

# URL the simulate_webhooks command posts webhooks to. When running the command
# inside the backend container (docker compose exec backend ...), localhost works.
PROCESSOR_WEBHOOK_URL=http://localhost:8000/webhooks/processor

## Label shown in the Django admin header to make the active environment explicit.
ADMIN_ENVIRONMENT_LABEL=Local
ADMIN_ENVIRONMENT_COLOR=#111827
ADMIN_ENVIRONMENT_BACKGROUND_COLOR=#f59e0b
